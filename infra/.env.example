# Modelo do infra/.env. Não preencha aqui: rode `node infra/scripts/init-env.mjs`,
# que copia este arquivo e gera um valor aleatório para cada variável vazia.
POSTGRES_DB=vida_publica
POSTGRES_USER=vp_owner
POSTGRES_PORT=5433
POSTGRES_PASSWORD=

# Usuários de cada componente (papéis com permissão mínima)
VP_INGEST_DB_PASSWORD=
VP_API_DB_PASSWORD=
VP_ADMIN_DB_PASSWORD=

S3_ACCESS_KEY=vp_s3
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_SECRET_KEY=

# Chave do HMAC usado para guardar CPFs apenas como hash (nunca o CPF em si)
VP_CPF_HASH_KEY=

API_PORT=3000
# Segredo HMAC dos tokens de acesso da API
VP_API_JWT_SECRET=
# Login Apple e Google: defina VP_APPLE_CLIENT_IDS e VP_GOOGLE_CLIENT_IDS
# (ids do app, separados por vírgula) para ligar; sem elas o login fica desligado.
# Origens da versão web do app aceitas por CORS (só desenvolvimento), ex.:
# VP_API_CORS_ORIGENS=http://localhost:8081
